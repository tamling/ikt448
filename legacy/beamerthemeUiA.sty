% ============================================================
%  beamerthemeUiA.sty  (clean / airy variant for IKT448, UiA)
%  Derived from beamerthemeKristiania.sty (Timo Amling, 2026).
%  Minimal default theme, one accent colour (UiA red), dark
%  UiA blue for structure, custom footline with part bubbles
%  and a slide progress bar, small UiA logo top-right.
%  Colours from the UiA brand book (uia.no/english/about-uia/
%  brand-book/colours.html): UiA red #C8102E, UiA blue #131E29.
% ============================================================
\ProvidesPackage{beamerthemeUiA}[2026/09/08 UiA clean theme for IKT448]
\mode<presentation>

\usetheme{default}
\setbeamertemplate{navigation symbols}{}
\RequirePackage{pgffor}
\RequirePackage{graphicx}
\RequirePackage{textcomp}
\RequirePackage{tikz}

% ---- Colours --------------------------------------------------------
\definecolor{uiared}{HTML}{C8102E}     % UiA red (Pantone 186)
\definecolor{uiablue}{HTML}{131E29}    % UiA blue (Pantone 7547)
\definecolor{uiagrey}{HTML}{595959}    % secondary text
\definecolor{uiamutedred}{HTML}{FEE7E8}
\definecolor{uiamutedblue}{HTML}{E1EDF9}
% Aliases so slide sources written for the Kristiania theme keep working
\colorlet{kristiania}{uiared}
\colorlet{kgrey}{uiagrey}

\setbeamercolor{normal text}{fg=uiablue}
\setbeamercolor{structure}{fg=uiared}
\setbeamercolor{title}{fg=uiared}
\setbeamercolor{subtitle}{fg=uiablue}
\setbeamercolor{frametitle}{fg=uiared}
\setbeamercolor{framesubtitle}{fg=uiagrey}
\setbeamercolor{itemize item}{fg=uiared}
\setbeamercolor{itemize subitem}{fg=uiared}
\setbeamercolor{itemize subsubitem}{fg=uiared}
\setbeamercolor{enumerate item}{fg=uiared}
\setbeamercolor{description item}{fg=uiared}
\setbeamercolor{block title}{bg=uiamutedred,fg=uiared}
\setbeamercolor{block body}{bg=gray!7,fg=uiablue}
\setbeamercolor{block title alerted}{bg=uiared,fg=white}
\setbeamercolor{block body alerted}{bg=uiamutedred,fg=uiablue}
\setbeamercolor{block title example}{bg=uiamutedblue,fg=uiablue}
\setbeamercolor{block body example}{bg=gray!7,fg=uiablue}
\setbeamercolor{button}{bg=uiared,fg=white}

% ---- Fonts (Computer Modern / Latin Modern -- house rule) -----------
\setbeamerfont{title}{size=\Huge,series=\bfseries}
\setbeamerfont{subtitle}{size=\large,series=\normalfont}
\setbeamerfont{frametitle}{size=\Large,series=\bfseries}
\setbeamerfont{framesubtitle}{size=\small,series=\normalfont}

% ---- Course constants (one edit here updates every deck) ------------
\newcommand{\coursecode}{IKT448}
\newcommand{\coursename}{ICT Research Methods}
\newcommand{\coursesemester}{Autumn 2026}
\newcommand{\lecturername}{Timo Amling}
\newcommand{\lecturertitle}{Assistant Professor}
\newcommand{\lecturermail}{timo.d.amling@uia.no}
\newcommand{\institution}{University of Agder}
\newcommand{\faculty}{Faculty of Engineering and Science}

% ---- Logo (top-right of content slides) -----------------------------
% Drop the official file named uia-logo.png next to the .tex to show it.
\newcommand{\UiALogo}{%
  \IfFileExists{uia-logo.png}{%
    \includegraphics[height=0.62cm]{uia-logo}}{}}

% ---- Frame title: clean, no bar, small logo top-right ---------------
\setbeamertemplate{frametitle}{%
  \vskip0.55em%
  \hbox to \textwidth{%
    \begin{minipage}[t]{\dimexpr\textwidth-1.2cm\relax}%
      \raggedright\hspace*{0.1em}{\usebeamerfont{frametitle}\usebeamercolor[fg]{frametitle}\insertframetitle}%
      \ifx\insertframesubtitle\empty\else%
        \\[0.1em]\hspace*{0.1em}{\usebeamerfont{framesubtitle}\usebeamercolor[fg]{framesubtitle}\insertframesubtitle}%
      \fi%
    \end{minipage}%
    \hfill
    % right edge of the logo flush with the "Slide n / N" text in the footer
    % (text margin 1cm minus the footer's 0.35cm inset = 0.65cm into the margin)
    \makebox[0pt][r]{\raisebox{-0.2cm}[0pt][0pt]{\UiALogo}\hspace*{-0.65cm}}%
  }%
  \vskip0.35em%
}

% ---- Session position (set per deck: \renewcommand{\sessionno}{N}) ----
\newcommand{\sessionno}{0}
\newcommand{\sessionstrip}{%
  \foreach \i in {1,...,12}{%
    \ifnum\i=\sessionno\relax{\color{uiared}\rule{0.16cm}{0.16cm}}%
    \else\ifnum\i<\sessionno\relax{\color{uiared!40}\rule{0.16cm}{0.16cm}}%
    \else{\color{uiagrey!30}\rule{0.16cm}{0.16cm}}\fi\fi\hspace{0.05cm}}}

% ---- Progress-bubble state (set by \partmark / \partdivider) --------
\newcommand{\Lnumparts}{5}      % parts per session (override per file if needed)
\newcounter{Lcurpart}\setcounter{Lcurpart}{0}
\newcommand{\Lcurtopic}{Overview}

% ---- Foot line: course tag | topic bubbles | counter ----------------
% On a first pass the total frame count is unknown (1); the guard below
% keeps the bar from overflowing TeX's dimension range on long decks.
\newcount\uia@total
% The progress bar divides before multiplying: the old form
% \paperwidth*\insertframenumber overflowed TeX's dimension range
% from frame 36 onwards ("Arithmetic overflow").
\setbeamertemplate{footline}{%
  \leavevmode%
  \hbox to \paperwidth{%
    \hskip0.35cm{\color{uiagrey}\scriptsize\textbf{\coursecode}~$\cdot$~\coursename~$\cdot$~\lecturername}%
    \hfill
    {\footnotesize
      \foreach \i in {1,...,\Lnumparts}{%
        \ifnum\i=\value{Lcurpart}{\color{uiared}$\bullet$}%
        \else\ifnum\i<\value{Lcurpart}{\color{uiared!50}$\bullet$}%
        \else{\color{uiagrey!45}$\circ$}\fi\fi\,%
      }%
    }\;{\color{uiared}\scriptsize\bfseries\Lcurtopic}%
    \hfill
    {\color{uiagrey}\scriptsize Slide~\insertframenumber\,/\,\inserttotalframenumber}\hskip0.35cm%
  }%
  \vskip2pt%
  \hbox{\color{uiared!18}\rule{\paperwidth}{1.4pt}}%
  \par\nointerlineskip\vskip-1.4pt%
  \uia@total=\inserttotalframenumber\relax
  \ifnum\uia@total<\insertframenumber\relax\uia@total=\insertframenumber\relax\fi
  \hbox{\color{uiared}\rule{\dimexpr(\paperwidth/\uia@total)*\insertframenumber\relax}{1.4pt}}%
}

% ---- Red title page (white text on UiA red) -------------------------
\newcommand{\redtitlepage}{%
  {\setbeamertemplate{footline}{}%
   \setbeamercolor{background canvas}{bg=uiared}%
   \setbeamercolor{title}{fg=white}\setbeamercolor{subtitle}{fg=white}%
   \setbeamercolor{author}{fg=white}\setbeamercolor{institute}{fg=white}%
   \setbeamercolor{date}{fg=white}\setbeamercolor{normal text}{fg=white}%
   \begin{frame}[plain]
     \titlepage
   \end{frame}}}

% ---- Part marker without a slide (keeps the 25-slide budget) --------
\newcommand{\partmark}[2]{\setcounter{Lcurpart}{#1}\gdef\Lcurtopic{#2}}

% ---- Red part divider (costs one slide; optional) -------------------
\newcommand{\partdivider}[3]{%
  \setcounter{Lcurpart}{#1}\gdef\Lcurtopic{#2}%
  {\setbeamertemplate{footline}{}%
   \setbeamercolor{background canvas}{bg=uiared}%
   \begin{frame}[plain]
     \vfill
     \begin{center}
       {\color{white}\large\bfseries PART #1}\\[0.9em]
       {\color{white}\Huge\bfseries #2}\\[0.9em]
       \begin{minipage}{0.74\textwidth}\centering\itshape\color{white}#3\end{minipage}
     \end{center}
     \vfill
   \end{frame}}%
}

