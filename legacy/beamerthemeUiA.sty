% ---- Learning outcomes slide (call \learningoutcomes{<today's focus>}) ---
% Wording is the official IKT448 text (uia.no, autumn 2026).
\newcommand{\learningoutcomes}[1]{%
  \begin{frame}{Learning outcomes --- \coursecode}
    \footnotesize After completing the course, the student should
    \vspace{0.1em}
    \renewcommand{\arraystretch}{1.25}
    \begin{tabular}{@{}p{0.9cm}p{12.6cm}@{}}
      \textbf{LO1} & have an overview of qualitative and quantitative research methods within ICT research, with an emphasis on methods used within cyber security\\
      \textbf{LO2} & have an understanding of the use of formal methods and models, and the validity of these methods\\
      \textbf{LO3} & be able to assess research-ethical aspects, with an emphasis on privacy and social responsibility\\
      \textbf{LO4} & have insight into the chosen project and how cyber security fits into an overall ICT setting\\
      \textbf{LO5} & have an understanding of the structure of scientific investigations within ICT and cyber security, the relationship between breadth and depth, and what limitations such investigations have\\
      \textbf{LO6} & be able to choose a suitable method in relation to the topic of a scientific investigation and problem solving within cyber security, such as e.g.\ a master's thesis\\
    \end{tabular}
    \vspace{0.45em}
    \begin{alertblock}{\small Today's session serves}
      \small #1
    \end{alertblock}
  \end{frame}%
}

% ---- Reading break-even slide (call \readingbreakeven{<session no>}) ----
