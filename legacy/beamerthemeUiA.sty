        \foreach \s in {1,...,12}{\draw[uiagrey] (\s*0.95,0)--(\s*0.95,-0.1) node[below,font=\tiny]{\s};}
        \draw[very thick, uiagrey] (0.95,1.0) -- (11.4,4.3);
        \node[font=\scriptsize\color{uiagrey}, align=center, rotate=17] at (6.1,3.15) {skipping the reading};
        \draw[very thick, uiared] (0.95,2.5) -- (11.4,1.7);
        \node[font=\scriptsize\color{uiared}] at (10.0,1.3) {reading first};
        \fill[black] (4.77,2.21) circle (0.08);
        \node[below,font=\scriptsize] at (4.77,2.05) {break-even};
        \draw[dashed, uiared] (#1*0.95, -0.55) -- (#1*0.95, 4.45);
        \node[font=\scriptsize\bfseries\color{uiared}, fill=white, inner sep=1pt, anchor=north]
          at (#1*0.95, -0.6) {you are here};
        % --- the monster of unread chapters, growing along the grey line ---
        \begin{scope}[shift={(3.2,2.05)}, scale=0.45]
          \fill[uiagrey!45, draw=uiagrey, thick] (0,0) ellipse (0.6 and 0.5);
          \fill[white] (-0.2,0.14) circle (0.12); \fill[white] (0.22,0.14) circle (0.12);
          \fill[black] (-0.17,0.14) circle (0.055); \fill[black] (0.25,0.14) circle (0.055);
          \draw[white, thick] (-0.32,-0.14) -- (-0.16,-0.26) -- (0,-0.14) -- (0.16,-0.26) -- (0.32,-0.14);
        \end{scope}
        \begin{scope}[shift={(10.6,4.55)}, scale=1.0]
          \fill[uiagrey!55, draw=uiagrey, very thick] (0,0) ellipse (0.75 and 0.6);
          \fill[uiagrey!55, draw=uiagrey, very thick] (-0.45,0.5) -- (-0.25,0.85) -- (-0.15,0.45) -- cycle;
          \fill[uiagrey!55, draw=uiagrey, very thick] (0.45,0.5) -- (0.25,0.85) -- (0.15,0.45) -- cycle;
